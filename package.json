{
  "name": "amelia-assistant",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node -e \"try{require('fs').rmSync('.next/cache',{recursive:true,force:true})}catch(e){}\"",
    "build:worker": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "d1:migrate:local": "wrangler d1 execute amelia-assistant-db --local --file=./migrations/0001_initial_schema.sql",
    "d1:migrate:remote": "wrangler d1 execute amelia-assistant-db --remote --file=./migrations/0001_initial_schema.sql",
    "lint": "next lint",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "wrangler dev --config wrangler.vinext.jsonc",
    "deploy:vinext": "vinext-cloudflare deploy --config wrangler.vinext.jsonc"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@opennextjs/cloudflare": "^1.20.15",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "next": "^15.5.29",
    "pg": "^8.23.1",
    "react": "latest",
    "react-dom": "latest",
    "tailwind-merge": "^3.0.2",
    "web-push": "^3.6.7",
    "vinext": "latest",
    "react-server-dom-webpack": "latest",
    "@vinext/cloudflare": "latest"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "wrangler": "^4.156.2",
    "vite": "latest",
    "@vitejs/plugin-react": "latest",
    "@vitejs/plugin-rsc": "latest",
    "@cloudflare/vite-plugin": "1"
  },
  "type": "module"
}
