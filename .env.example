# ==========================================
# Amelia Assistant - Environment Configuration
# ==========================================

# Google Gemini API Key (Required for AI features)
# Obtain your API key at: https://aistudio.google.com/app/apikey
# NEVER commit your real API key to GitHub or public repositories.
GEMINI_API_KEY=your_gemini_api_key_here

# Default Gemini Model
# - gemini-3.5-flash-lite (default: ultra-fast, responsive, supports thinking levels)
# - gemini-3.8-flash (balanced multimodal & reasoning)
GEMINI_MODEL=gemini-3.5-flash-lite

# Database Connection (Optional for local, Recommended for Render)
# - Leave blank to use local SQLite database stored at ./data/amelia.db
# - On Render, configure this to your Render PostgreSQL database internal URL:
#   e.g., postgresql://amelia_user:password@dpg-xxxxxx-a:5432/amelia_assistant
DATABASE_URL=

# Web Push Notifications (Optional: browser notifications work locally without this)
# Generate VAPID keys using: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@example.com

# Server Port (Render sets this automatically)
PORT=3000
NODE_ENV=production
